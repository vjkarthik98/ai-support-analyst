# ===========================================================================
# AI Support Ticket Analyst - environment configuration
#
#   .env.example  committed template: every setting, with safe defaults
#   .env          your local copy with a real key - git-ignored, NEVER commit
#
# Create your copy, then set GROQ_API_KEY:
#   Windows:       Copy-Item .env.example .env
#   macOS/Linux:   cp .env.example .env
#
# Every value is validated at startup, so a typo fails immediately with a
# message naming the setting. Unrecognised names are rejected too, rather than
# silently ignored.
# ===========================================================================


# --- Language model ---------------------------------------------------------

# Free key from https://console.groq.com -> API Keys -> Create API Key.
# Without one the system still starts: /health, /schema and anomaly detection
# work fully; only natural-language questions are unavailable.
GROQ_API_KEY=gsk_replace_me

# Chat model. The largest on Groq's free tier, for the most headroom on
# unfamiliar question phrasing. Verified free-tier alternatives, with the
# same limits - swap if this one degrades:
#   qwen/qwen3.8-27b     strong at SQL generation
#   openai/gpt-oss-20b   fastest, least reasoning headroom
GROQ_MODEL=openai/gpt-oss-120b

# Seconds to wait for one model call. A call that times out is not retried,
# so this is the most a single call can take.
LLM_TIMEOUT_SECONDS=30

# Retries after a dropped connection or a provider-side (5xx) error. 0 to 5.
# Rate limits and timeouts are never retried: waiting seconds cannot recover
# a per-minute or per-day token budget.
LLM_MAX_RETRIES=2


# --- Dataset ----------------------------------------------------------------

# CSV loaded at startup. A relative path resolves from the project folder.
CSV_PATH=data/support_tickets.csv

# The reference "now" for relative dates such as "this week".
# The data is a fixed snapshot ending 2024-03-30, so the real clock would make
# every such question return zero rows. Leave BLANK to anchor on the latest
# ticket (recommended). Set a time - no timezone - to reproduce an earlier
# moment, e.g. AS_OF=2024-02-01 12:00; tickets raised after it are excluded.
AS_OF=


# --- Anomaly detection ------------------------------------------------------

# Tukey fence multiplier for resolution-time outliers: Q3 + k x IQR.
# 1.5 is the standard value and flags 21 of 327 resolved tickets.
# Raise it to flag fewer.
IQR_MULTIPLIER=1.5

# Age in hours after which an unresolved High or Critical ticket counts as an
# SLA breach.
SLA_BREACH_HOURS=24


# --- Query safety -----------------------------------------------------------

# Most rows a generated query may return. The answer's wording is written
# from the first 20; every row is returned to the caller.
MAX_RESULT_ROWS=500

# Seconds a generated query may run before it is stopped. A valid read-only
# query can still run forever (a recursive CTE); only a time limit stops it.
QUERY_TIMEOUT_SECONDS=5


# --- Services ---------------------------------------------------------------

API_HOST=127.0.0.1
API_PORT=8000
UI_PORT=8501


# --- Diagnostics ------------------------------------------------------------

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
#   INFO     recommended: startup, declined questions, rejected SQL, repairs
#   DEBUG    adds the model's tool choice, the SQL it ran, and each anomaly
#            detector's decision - for tracing a wrong answer. Libraries stay
#            at INFO, so their own debug output does not bury these lines.
#   WARNING  only retries, rate limits and replaced answers
#   ERROR    only failures
#   CRITICAL nothing - the app logs nothing at this level
LOG_LEVEL=INFO
