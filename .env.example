# ---------------------------------------------------------------------------
# Environment template.
#
# Copy this file to `.env` and fill in your own key:
#     Copy-Item .env.example .env
#
# `.env` is git-ignored and must never be committed. This template IS
# committed, so anyone cloning the repo can see exactly which settings exist
# and what they mean without ever seeing a real credential.
# ---------------------------------------------------------------------------

# --- LLM provider (required) -----------------------------------------------
# Free API key from https://console.groq.com  ->  API Keys  ->  Create API Key
GROQ_API_KEY=gsk_replace_me

# Chat model used for natural-language understanding.
# Chosen: the largest model on Groq's free tier, for maximum headroom on
# unfamiliar question phrasing.
#   Verified free-tier alternatives (identical limits - swap if one degrades):
#     qwen/qwen3.8-27b     - fallback, strong at SQL generation
#     openai/gpt-oss-20b   - fastest, least reasoning headroom
GROQ_MODEL=openai/gpt-oss-120b

# --- Dataset ---------------------------------------------------------------
CSV_PATH=data/support_tickets.csv

# ---------------------------------------------------------------------------
# AS_OF - the reference "now" for all relative time expressions.
#
# The dataset is a static historical snapshot ending 2024-03-30. Questions like
# "how many tickets this week" would return zero rows if resolved against the
# real system clock, making a working system look broken.
#
# Leave BLANK to auto-anchor to max(created_at) in the CSV - the default and
# recommended behaviour. Set an explicit timestamp only to reproduce a specific
# point in time, e.g. AS_OF=2024-03-30 18:06
# ---------------------------------------------------------------------------
AS_OF=

# --- Anomaly detection thresholds ------------------------------------------
# Multiplier on the interquartile range. 1.5 is the standard Tukey fence and
# flags 21 of 327 resolved tickets (6.4%). Raise it to flag fewer.
IQR_MULTIPLIER=1.5

# Hours after which an unresolved High/Critical ticket counts as an SLA breach.
SLA_BREACH_HOURS=24

# --- Service ports ---------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
UI_PORT=8501

# Maximum rows a generated SQL query may return. Caps both response size and
# the token cost of the narration call, which matters on an 8K tokens/minute
# free-tier budget.
MAX_RESULT_ROWS=500
